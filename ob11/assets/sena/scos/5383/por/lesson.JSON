], "id": 11, "type": "TYP", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "John and Sally ask questions. What do they ask?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 3"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Listening"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words.</span><span class=\"bullet\">Use capital letters where necessary.</span>"}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}], "template_override": 1}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Sally in the UK"}, {"type": "unit_name", "content": "On the Bus"}, {"type": "position", "content": 11}, {"type": "origin", "content": "scholar > Famous Structures > Buckingham Palace"}, {"type": "lesson", "content": 8}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_5", "content": " Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_6", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_7", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": " Identifies general information in short written or spoken conversations."}]}, {"type": "background_image", "content": "engenn4le08ob11re1img01.jpg"}, {"type": "target_word", "contents": [{"type": "name", "content": "picture "}, {"type": "definition", "content": "photograph "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: If you want to take a few more pictures, please feel free."}, {"type": "audio", "content": "engenn4le08ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when you visit a new place."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Prepositions of Place"}, {"type": "describer", "content": "When you say where things are, you use prepositions of place like <span class=\"italic\">along, through, across, on</span> or <span class=\"italic\">at, inside, outside</span> or <span class=\"italic\">around</span>."}, {"type": "table", "content": "{\"rows\":9,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Preposition </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Use </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Example </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" in \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" a room, a city\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" See the fine antique furniture and works of art in the State Rooms?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"on \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" a street, a river bank\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" The museum is on the south bank.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"through \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" a open area, like a park or a market\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You can walk through the market.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"across \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" a street, a river\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" The bridge goes across the River Thames.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"inside \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" a building\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" That means the Queen is inside the building.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"outside \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" a building\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Did you notice the Royal Standard outside the palace?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"around \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" outside a building\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You can see the beautiful 40-acre garden and lake. around the palace.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"along\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" beside a path or a river\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I loved walking along the River Thames.\\\"}\"],\"styles\":\"\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Near - Far"}, {"type": "describer", "content": "You can use the adjectives <span class =\"strong\">near, close</span> and <span class =\"strong\">far</span> to say the distance of one thing or place to another."}, {"type": "example", "content": "How far is it?<br /> It's about 10 miles away. <br />It's about 40-minute walk.<br /> That's too far to walk.<br /> The Underground is close."}, {"type": "text", "content": "<span class=\"italic\">Near</span> and <span class=\"italic\">close</span> have the same meaning. <span class=\"italic\">Far</span> has the opposite meaning."}, {"type": "text", "content": "The expression too <span class=\"italic\">far</span> means something is very far in a negative way."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "prehistoric "}, {"type": "definition", "content": "dating from the time before writing "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Stonehenge is the most famous prehistoric monument in the world."}, {"type": "audio", "content": "engenn4le08ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "stone "}, {"type": "definition", "content": "material that comes from the ground "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: What kind of stones are they?"}, {"type": "audio", "content": "engenn4le08ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "excursion "}, {"type": "definition", "content": "a short trip "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: It's a 10-hour excursion to Stonehenge."}, {"type": "audio", "content": "engenn4le08ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "famous "}, {"type": "definition", "content": "many people know about it "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Not too far from there is Tower Bridge, a very famous bridge."}, {"type": "audio", "content": "engenn4le08ob11aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "technology "}, {"type": "definition", "content": "ideas and equipment to improve they way we live "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Ancient people built huge monuments with very little technology."}, {"type": "audio", "content": "engenn4le08ob11aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Do a search online for words and expressions people use in texting."}, {"type": "text", "content": "Write a list of 20 words and expressions. For each one, explain what it means using normal words."}, {"type": "text", "content": "Write a funny text message conversation using the short forms."}, {"type": "text", "content": "Practice reading the dialogue with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I identify 20 short forms of words or expressions online."}, {"type": "text", "content": "I write the meanings of short forms used in conversations."}, {"type": "text", "content": "I write a text message conversation using short forms."}, {"type": "text", "content": "I practice the dialogue with a partner."}]}], "type": "sena"}