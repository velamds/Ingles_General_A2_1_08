{"_data": [{"contents": [{"content": "Sally in the UK", "type": "lesson_name"}, {"content": "Any Questions?", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "scholar > Famous Structures > Buckingham Palace", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Asking and Making Suggestions", "type": "heading"}, {"content": "<span class=\"strong\">You can ask for a suggestion with a question:</span><br><br><li> <span class=\"italic\">Do you have any suggestions?</span> </li><li> <span class=\"italic\">What do you suggest?</span> </li> <br><span class=\"strong\">Suggestions can be made in many different ways.  Here are some:</span><br> <span class=\"underline\">You can use the Imperative form:</span> <br><li><span class=\"italic\">Take a close look.</span> </li><li><span class=\"italic\">Look in this direction. </span></li><li><span class=\"italic\">Please feel free to ask questions!</span> </li> <br><span class=\"underline\">You can use a modal, like <span class=\"strong\">can</span>  or <span class=\"strong\">could</span>:</span> <li><span class=\"italic\">You could visit many of those sites.</span> </li><li><span class=\"italic\">We could go to Buckingham Palace.</span> <br> <br><span class=\"underline\">You can use a Wh- question:</span><li> <span class=\"italic\">Why don't you sign up for another excursion?</span> </li><li><span class=\"italic\">How about going on a tour of Scotland?</span>  <br><br> <span class=\"underline\">You can use the word let's:</span>  <li> <span class=\"italic\">Let's go to the gift shop.</span> ", "type": "describer"}], "type": "learning_points"}, {"contents": [{"content": "hanging", "type": "name"}, {"content": "suspended from above ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The word \"Stonehenge\" means hanging stones.", "type": "example"}, {"content": "engenn4le08ob09aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when you visit Stonehenge.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to seem ", "type": "name"}, {"content": "to appear", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Do you see how they seem to be hanging in the air?", "type": "example"}, {"content": "engenn4le08ob09aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "wheel", "type": "name"}, {"content": "a round circle used in cars, bicycles, etc.", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: These ancient people did not use the wheel.", "type": "example"}, {"content": "engenn4le08ob09aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content