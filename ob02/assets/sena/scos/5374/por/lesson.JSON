enn4le08ob02re7pdf01.pdf"}]}], "id": 0, "responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}]}], "stimuli_ids": [], "id": 11, "type": "DWS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Discuss the sights of your town or city."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}]}], "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Sally in the UK"}, {"type": "unit_name", "content": "London Is Great!"}, {"type": "position", "content": 2}, {"type": "origin", "content": "scholar > Exploring Ancient Sites > Stonehenge"}, {"type": "lesson", "content": 8}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about directions to places in  a limited range of social situations."}, {"type": "secondary_1", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_2", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_5", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Talking About Places and Location"}, {"type": "describer", "content": "You can ask about places with the question <span class=\"italic\">Where is \u2026 ?</span>  or <span class=\"italic\">Where is that?</span> <br><br>When you say where things are, you can use these expressions: <br>It's not far from here.<br>It's located ...<br>Not too far from there is ..."}, {"type": "example", "content": "Westminster is not far from here."}, {"type": "example", "content": "They're all located within walking distance of each other."}, {"type": "example", "content": "Not too far from there is Tower Bridge."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Prepositions of Place"}, {"type": "describer", "content": "When you say where things are, you use prepositions of place like <span class=\"italic\">along, through, across, on</span> or <span class=\"italic\">at.</span>    <br><br> You walk <span class=\"strong\">along</span> a path, like a river. <br>You go <span class=\"strong\">through</span> a space, like a city. <br>A bridge goes <span class=\"strong\">across</span> a river.<br>Something is located <span class=\"strong\">on</span> a river bank.<br>You use <span class=\"strong\">at </span>to talk about a place, like a pub."}, {"type": "example", "content": "<span class=\"strong\">Sally</span>:  I loved walking along the River Thames.<br> <span class=\"strong\">Vanessa</span>: Where is that? <br><span class=\"strong\">Sally</span>: It flows through the whole city."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "river "}, {"type": "definition", "content": "water that flows across land"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I loved walking along the River Thames."}, {"type": "audio", "content": "engenn4le08ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear when you visit London."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to perform "}, {"type": "definition", "content": "to demonstrate a talent in public (act, sing, dance, etc.)"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: This is where William Shakespeare performed his plays."}, {"type": "audio", "content": "engenn4le08ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "theater "}, {"type": "definition", "content": "a building where plays are performed"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The Globe is one of the world's most famous theaters."}, {"type": "audio", "content": "engenn4le08ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "famous"}, {"type": "definition", "content": "many people know about it"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Not too far from there is Tower Bridge, a very famous bridge."}, {"type": "audio", "content": "engenn4le08ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "south bank"}, {"type": "definition", "content": "one side of a river"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The Globe theatre is on the south bank."}, {"type": "audio", "content": "engenn4le08ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "reproduction"}, {"type": "definition", "content": "a copy"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: It's a reproduction of the theater where William Shakespeare performed his plays."}, {"type": "audio", "content": "engenn4le08ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to be located"}, {"type": "definition", "content": "to be in a place"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: They're all located within walking distance of each other."}, {"type": "audio", "content": "engenn4le08ob02aud07"}]}, {"type": "background_image", "content": "engenn4le08ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of an interesting place in your community or city."}, {"type": "text", "content": "With a partner, discuss why it is interesting."}, {"type": "text", "content": "Explain where it is. Use expressions and prepositions of place you learned in this lesson."}, {"type": "text", "content": "Your partner talks about a different place. Ask your partner questions."}, {"type": "text", "content": "Discuss more places."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I discuss 2-3 interesting places in my community."}, {"type": "text", "content": "I say where the places are located."}, {"type": "text", "content": "I ask my partner questions about places."}]}], "type": "sena"}